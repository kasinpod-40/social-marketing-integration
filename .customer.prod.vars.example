# Customer PROD credentials for Social MKT Data Hub -> customer Base full-parity work.
#
# IMPORTANT
# - Copy this file to `.customer.prod.vars` on the operator Mac.
# - Put real customer PROD values only in `.customer.prod.vars`.
# - `.customer.prod.vars` is git-ignored and must never be committed.
# - Do not paste tenant_access_token here; the operator requests it from Lark using App ID/Secret.

# Customer-owned Lark application credentials with permission to write/read TARGET Base.
LARK_APP_ID=
LARK_APP_SECRET=

# SOURCE authority = exact local Lark Base export approved for this migration.
# Current closeout authority SHA-256:
# 9c24f5da1400d05ca0c070ab736e87c49e7ff4ea78e854a96d4e4c2c3ab267f7
LARK_CUSTOMER_CONSOLIDATION_SOURCE_EXPORT_FILE=/Users/wasanjantawong/Desktop/Social MKT Data Hub.base

# Optional diagnostic only; never used as the migration authority gate.
# LARK_CUSTOMER_CONSOLIDATION_SOURCE_APP_TOKEN=

# TARGET Base: customer `✨Marketing Content Calendar`.
# Use the Base app token only (not the full URL).
LARK_CUSTOMER_CONSOLIDATION_TARGET_APP_TOKEN=

# One-run confirmation used only by the documented visible-field-order operator.
# Prefer setting this inline for the apply command instead of persisting it here.
# CUSTOMER_BASE_VISIBLE_FIELD_ORDER_CONFIRMATION=APPLY_CUSTOMER_BASE_VISIBLE_FIELD_ORDER_V1

# Optional read-performance tuning. Leave commented unless needed.
# LARK_REQUEST_TIMEOUT_MS=30000
# LARK_MAX_ATTEMPTS=5
# LARK_MIN_REQUEST_INTERVAL_MS=150
