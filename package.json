{
  "name": "social-marketing-integration",
  "version": "0.11.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "test": "npm run test:unit && npm run test:worker",
    "test:unit": "find tests -type f -name '*.test.js' ! -path 'tests/worker-runtime/*' -print0 | xargs -0 node --test",
    "test:worker": "vitest run --config vitest.worker.config.js",
    "check": "find apps packages tests scripts -type f \\( -name '*.js' -o -name '*.mjs' \\) -print0 | xargs -0 -n1 node --check && node scripts/audit-architecture.mjs && node scripts/check-repository-hygiene.mjs",
    "validate:tiktok": "node scripts/validate-tiktok-creator.mjs",
    "sync:tiktok": "node scripts/sync-tiktok-creator.mjs",
    "seed:metrics": "node scripts/seed-metric-definitions.mjs",
    "audit:architecture": "node scripts/audit-architecture.mjs",
    "deploy:dry-run": "wrangler deploy --dry-run --config wrangler.sync.example.jsonc",
    "seed:report-settings": "node scripts/seed-report-settings.mjs",
    "setup:report-schema": "node scripts/setup-report-schema.mjs",
    "setup:report-schema:apply": "node scripts/setup-report-schema.mjs --apply",
    "test:report-reliability": "node --test tests/application/calculate-tiktok-organic-report.test.js tests/application/generate-tiktok-organic-report.test.js tests/application/load-tiktok-organic-report-source.test.js tests/application/queue-job.test.js tests/application/report-config-loaders.test.js tests/application/report-output-rows.test.js tests/application/report-period.test.js tests/application/report-snapshot.test.js tests/application/tiktok-organic-report-source.test.js tests/reliability/reliable-sync-runner.test.js tests/application/scheduled-jobs.test.js",
    "setup:report-views": "node scripts/setup-report-views.mjs",
    "setup:report-views:apply": "node scripts/setup-report-views.mjs --apply",
    "enable:tiktok-report-schedules": "node scripts/enable-tiktok-report-schedules.mjs",
    "enable:tiktok-report-schedules:apply": "node scripts/enable-tiktok-report-schedules.mjs --apply",
    "release:package": "node scripts/package-clean-release.mjs",
    "release:verify": "node scripts/verify-release-archive.mjs",
    "setup:youtube-schema": "node scripts/setup-youtube-schema.mjs",
    "setup:youtube-schema:apply": "node scripts/setup-youtube-schema.mjs --apply",
    "preflight:youtube": "node scripts/preflight-youtube-dev-access.mjs",
    "job:youtube-sync": "node scripts/print-youtube-sync-job.mjs",
    "job:redrive-dead-letter": "node scripts/print-dead-letter-redrive-job.mjs",
    "analyze:lark-base-export": "node scripts/analyze-lark-base-export.mjs",
    "preview:shared-table-schema": "node scripts/preview-shared-table-schema.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.18.4",
    "vitest": "4.1.10",
    "wrangler": "4.110.0"
  }
}
