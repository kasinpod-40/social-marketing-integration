{
  "name": "social-marketing-integration",
  "version": "0.2.7-live-contract-preflight",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "node --test tests/**/*.test.js",
    "check": "find apps packages tests scripts -name '*.js' -o -name '*.mjs' | xargs -n1 node --check",
    "validate:tiktok": "node scripts/validate-tiktok-creator.mjs",
    "sync:tiktok": "node scripts/sync-tiktok-creator.mjs",
    "seed:metrics": "node scripts/seed-metric-definitions.mjs"
  }
}
