{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "social-mkt-sync-worker",
  "main": "./apps/sync-worker/src/index.js",
  "compatibility_date": "2026-07-01",

  "triggers": {
    // ตัวอย่าง Cron รายชั่วโมง สามารถเปลี่ยนภายหลังตามรอบข้อมูลจริงของลูกค้า
    "crons": ["0 * * * *"]
  },

  "d1_databases": [
    {
      // D1 เป็น operational source of truth สำหรับ Sync runs, Locks, DLQ และ Alerts
      "binding": "MKT_STATE_DB",
      "database_name": "social-mkt-state-dev",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "./migrations"
    }
  ],

  "queues": {
    "producers": [
      {
        // Scheduled handler ส่งงานเข้า Queue นี้เท่านั้น ไม่ทำ Sync โดยตรง
        "binding": "MKT_SYNC_QUEUE",
        "queue": "social-mkt-sync-jobs"
      }
    ],
    "consumers": [
      {
        "queue": "social-mkt-sync-jobs",
        "max_concurrency": 1,
        "max_batch_size": 10,
        "max_batch_timeout": 30,
        "max_retries": 5,
        "dead_letter_queue": "social-mkt-sync-dlq"
      },
      {
        // DLQ มี Consumer แยกและบันทึกอย่างเดียว ห้าม Execute งานเดิมซ้ำ
        "queue": "social-mkt-sync-dlq",
        "max_concurrency": 1,
        "max_batch_size": 10,
        "max_batch_timeout": 30,
        "max_retries": 10
      }
    ]
  },

  "vars": {
    "MKT_ENV": "development",
    "MKT_CUSTOMER_PROFILE": "dev_ft_pumkin",
    "DEFAULT_TIMEZONE": "Asia/Bangkok",

    "MKT_CONNECTOR_TIKTOK_ENABLED": "true",
    "MKT_CONNECTOR_FACEBOOK_ENABLED": "false",
    "MKT_CONNECTOR_INSTAGRAM_ENABLED": "false",
    "MKT_CONNECTOR_YOUTUBE_ENABLED": "false",
    "MKT_CONNECTOR_WOOCOMMERCE_ENABLED": "false",
    "MKT_CONNECTOR_CHATWOOT_ENABLED": "false",

    "MKT_SCHEDULE_TIKTOK_ENABLED": "true",
    "MKT_MAIN_QUEUE_NAME": "social-mkt-sync-jobs",
    "MKT_DLQ_QUEUE_NAME": "social-mkt-sync-dlq",
    "MKT_QUEUE_RETRY_DELAY_SECONDS": "30",

    // เปิด Checkpoint/Fingerprint ใน D1 เพื่อประมวลผลปลายทางเฉพาะ RAW records ที่เปลี่ยน
    "MKT_TIKTOK_INCREMENTAL_ENABLED": "true",
    // บังคับ Full reconciliation อย่างน้อยวันละครั้ง แม้ไม่มี Fingerprint เปลี่ยน
    "MKT_TIKTOK_FULL_RECONCILIATION_INTERVAL_MS": "86400000",

    "TIKTOK_SOURCE_HANDLE": "ft.pumkin",

    // Lease 10 นาที และต่ออายุทุก 2 นาที เพื่อลดความเสี่ยง Lock หมดกลางงาน
    "MKT_SYNC_LOCK_LEASE_MS": "600000",
    "MKT_SYNC_LOCK_RENEW_INTERVAL_MS": "120000",

    // Table IDs ของ DEV Base ของผู้พัฒนา ตัวอย่างนี้ต้องแทนค่าก่อน Deploy จริง
    "LARK_TABLE_RAW_TIKTOK_CREATOR_VIDEOS": "replace-with-table-id",
    "LARK_TABLE_MKT_CONTENT": "replace-with-table-id",
    "LARK_TABLE_MKT_CONTENT_DAILY": "replace-with-table-id",
    "LARK_TABLE_MKT_CLASSIFICATION_DICTIONARY": "replace-with-table-id",
    "LARK_TABLE_MKT_METRIC_DEFINITIONS": "replace-with-table-id",
    "LARK_TABLE_MKT_SYNC_LOG": "replace-with-table-id",
    "LARK_TABLE_MKT_SYSTEM_ALERTS": "replace-with-table-id",

    "LARK_MIN_REQUEST_INTERVAL_MS": "150",
    "LARK_REQUEST_TIMEOUT_MS": "30000",
    "LARK_MAX_ATTEMPTS": "5",
    "LARK_MAX_PAGES": "1000",
    "LARK_MAX_FILTER_CONDITIONS": "50"
  }
}
