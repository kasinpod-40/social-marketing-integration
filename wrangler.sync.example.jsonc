{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "social-mkt-sync-worker",
  "main": "./apps/sync-worker/src/index.js",
  "compatibility_date": "2026-07-15",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": true, "persist": true, "head_sampling_rate": 1 }, "traces": { "enabled": true, "persist": true, "head_sampling_rate": 1 } },
  "triggers": { "crons": ["*/5 * * * *", "50 0,6,12,18 * * *"] },
  "d1_databases": [{ "binding": "MKT_STATE_DB", "database_name": "replace-with-environment-specific-d1-name", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "./migrations" }],
  "queues": {
    "producers": [{ "binding": "MKT_SYNC_QUEUE", "queue": "social-mkt-sync-jobs" }],
    "consumers": [
      { "queue": "social-mkt-sync-jobs", "max_concurrency": 1, "max_batch_size": 10, "max_batch_timeout": 30, "max_retries": 5, "dead_letter_queue": "social-mkt-sync-dlq" },
      { "queue": "social-mkt-sync-dlq", "max_concurrency": 1, "max_batch_size": 10, "max_batch_timeout": 30, "max_retries": 10 }
    ]
  },
  "vars": {
    "MKT_ENV": "development",
    "MKT_CUSTOMER_PROFILE": "replace-with-customer-profile",
    "DEFAULT_TIMEZONE": "Asia/Bangkok",
    "MKT_CONNECTOR_TIKTOK_ENABLED": "false",
    "MKT_CONNECTOR_FACEBOOK_ENABLED": "false",
    "MKT_CONNECTOR_INSTAGRAM_ENABLED": "false",
    "MKT_CONNECTOR_YOUTUBE_ENABLED": "false",
    "MKT_YOUTUBE_ANALYTICS_ENABLED": "false",
    "MKT_CONNECTOR_WOOCOMMERCE_ENABLED": "false",
    "MKT_CONNECTOR_CHATWOOT_ENABLED": "false",
    "MKT_SCHEDULE_TIKTOK_ENABLED": "false",
    "MKT_SCHEDULE_YOUTUBE_ENABLED": "false",
    "MKT_YOUTUBE_ANALYTICS_TIME": "07:50",
    "MKT_YOUTUBE_ANALYTICS_LOOKBACK_DAYS": "7",
    "MKT_SCHEDULE_DAILY_REPORT_ENABLED": "false",
    "MKT_SCHEDULE_WEEKLY_REPORT_ENABLED": "false",
    "MKT_DAILY_REPORT_TIME": "08:10",
    "MKT_WEEKLY_REPORT_TIME": "08:15",
    "MKT_WEEKLY_REPORT_WEEKDAY": "monday",
    "MKT_REPORT_MAX_CONTENT_RECORDS": "800",
    "MKT_REPORT_MAX_SNAPSHOT_RECORDS": "50000",
    "MKT_REPORT_MAX_FALLBACK_SCAN_RECORDS": "50000",
    "MKT_REPORT_MAX_PAGES_PER_QUERY": "100",
    "MKT_REPORT_SOURCE_PAGE_SIZE": "500",
    "MKT_DAILY_REPORT_SETTING_KEY": "replace-with-daily-report-setting-key",
    "MKT_WEEKLY_REPORT_SETTING_KEY": "replace-with-weekly-report-setting-key",
    "MKT_MAIN_QUEUE_NAME": "social-mkt-sync-jobs",
    "MKT_DLQ_QUEUE_NAME": "social-mkt-sync-dlq",
    "MKT_DLQ_REDRIVE_ENABLED": "false",
    "MKT_QUEUE_RETRY_DELAY_SECONDS": "30",
    "MKT_RELIABILITY_MIRROR_BATCH_SIZE": "25",
    "MKT_TIKTOK_INCREMENTAL_ENABLED": "false",
    "MKT_TIKTOK_FULL_RECONCILIATION_INTERVAL_MS": "86400000",
    "MKT_TIKTOK_SOURCE_PAGE_SIZE": "500",
    "MKT_TIKTOK_SOURCE_MAX_PAGES": "1000",
    "MKT_YOUTUBE_RECENT_VIDEO_LIMIT": "100",
    "MKT_YOUTUBE_FULL_RECONCILIATION_INTERVAL_MS": "86400000",
    "MKT_YOUTUBE_ANALYTICS_MAX_PAGES": "1000",
    "YOUTUBE_API_TIMEOUT_MS": "30000",
    "YOUTUBE_MAX_PAGES": "100",
    "TIKTOK_SOURCE_HANDLE": "replace-with-tiktok-handle",
    "YOUTUBE_CHANNEL_ID": "replace-with-youtube-channel-id",
    "MKT_SYNC_LOCK_LEASE_MS": "600000",
    "MKT_SYNC_LOCK_RENEW_INTERVAL_MS": "120000",
    "LARK_TABLE_RAW_TIKTOK_CREATOR_VIDEOS": "replace-with-table-id",
    "LARK_TABLE_RAW_YOUTUBE_CHANNELS": "replace-with-table-id",
    "LARK_TABLE_RAW_YOUTUBE_VIDEOS": "replace-with-table-id",
    "LARK_TABLE_RAW_YOUTUBE_ANALYTICS_DAILY": "replace-with-table-id",
    "LARK_TABLE_MKT_ACCOUNTS": "replace-with-table-id",
    "LARK_TABLE_MKT_CONTENT": "replace-with-table-id",
    "LARK_TABLE_MKT_CONTENT_DAILY": "replace-with-table-id",
    "LARK_TABLE_MKT_ACCOUNT_DAILY": "replace-with-table-id",
    "LARK_TABLE_RAW_FACEBOOK_PAGES": "replace-with-table-id",
    "LARK_TABLE_RAW_FACEBOOK_POSTS": "replace-with-table-id",
    "LARK_TABLE_RAW_FACEBOOK_POST_INSIGHTS": "replace-with-table-id",
    "LARK_TABLE_RAW_FACEBOOK_PAGE_INSIGHTS": "replace-with-table-id",
    "LARK_TABLE_RAW_INSTAGRAM_ACCOUNTS": "replace-with-table-id",
    "LARK_TABLE_RAW_INSTAGRAM_MEDIA": "replace-with-table-id",
    "LARK_TABLE_RAW_INSTAGRAM_MEDIA_INSIGHTS": "replace-with-table-id",
    "LARK_TABLE_RAW_INSTAGRAM_ACCOUNT_INSIGHTS": "replace-with-table-id",
    "LARK_TABLE_RAW_META_AD_ACCOUNTS": "replace-with-table-id",
    "LARK_TABLE_RAW_META_CAMPAIGNS": "replace-with-table-id",
    "LARK_TABLE_RAW_META_AD_SETS": "replace-with-table-id",
    "LARK_TABLE_RAW_META_ADS": "replace-with-table-id",
    "LARK_TABLE_RAW_META_CREATIVES": "replace-with-table-id",
    "LARK_TABLE_RAW_META_ADS_INSIGHTS": "replace-with-table-id",
    "LARK_TABLE_MKT_ADS_ACCOUNTS": "replace-with-table-id",
    "LARK_TABLE_MKT_ADS_CAMPAIGNS": "replace-with-table-id",
    "LARK_TABLE_MKT_ADS_ADGROUPS": "replace-with-table-id",
    "LARK_TABLE_MKT_ADS_ADS": "replace-with-table-id",
    "LARK_TABLE_MKT_ADS_CREATIVES": "replace-with-table-id",
    "LARK_TABLE_MKT_ADS_DAILY": "replace-with-table-id",
    "LARK_TABLE_MKT_CLASSIFICATION_DICTIONARY": "replace-with-table-id",
    "LARK_TABLE_MKT_METRIC_DEFINITIONS": "replace-with-table-id",
    "LARK_TABLE_MKT_REPORT_SETTINGS": "replace-with-table-id",
    "LARK_TABLE_MKT_REPORT_SNAPSHOTS": "replace-with-table-id",
    "LARK_TABLE_MKT_REPORT_METRIC_VALUES": "replace-with-table-id",
    "LARK_TABLE_MKT_REPORT_TOP_CONTENT": "replace-with-table-id",
    "LARK_TABLE_MKT_SYNC_LOG": "replace-with-table-id",
    "LARK_TABLE_MKT_SYSTEM_ALERTS": "replace-with-table-id",
    "LARK_MIN_REQUEST_INTERVAL_MS": "150",
    "LARK_REQUEST_TIMEOUT_MS": "30000",
    "LARK_MAX_ATTEMPTS": "5",
    "LARK_MAX_PAGES": "1000",
    "LARK_MAX_FILTER_CONDITIONS": "50"
  }
}
