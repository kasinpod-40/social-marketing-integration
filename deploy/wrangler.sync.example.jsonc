{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "social-mkt-sync-worker",
  "main": "apps/sync-worker/src/index.js",
  "compatibility_date": "2026-07-01",
  "queues": {
    "consumers": [
      {
        // บังคับให้ Cloudflare เปิด Consumer invocation พร้อมกันได้สูงสุดหนึ่งชุด
        // เพราะ Stable-key plan/create ยังไม่มี Distributed lock ครอบหลาย Worker invocation
        // ห้ามเพิ่มค่านี้จนกว่าจะมี Lock/Reservation กลางที่พิสูจน์การป้องกัน Duplicate แล้ว
        "queue": "social-mkt-sync-jobs",
        "max_concurrency": 1,

        // ภายในหนึ่ง Batch ตัว Worker จะประมวลผล Message ตามลำดับและแชร์ Token/Schema cache
        "max_batch_size": 10,
        "max_batch_timeout": 30,
        "max_retries": 5
      }
    ]
  },
  "vars": {
    // Production ใช้โปรไฟล์และทรัพยากรของ Chemistry K ที่ลูกค้าเป็นเจ้าของ
    "MKT_ENV": "production",
    "MKT_CUSTOMER_PROFILE": "chemistry_k",
    "DEFAULT_TIMEZONE": "Asia/Bangkok",

    // App Token และ Table IDs ไม่ใช่ Secret แต่ต้องเป็นค่าจาก Base ของลูกค้า
    "LARK_APP_TOKEN": "replace-with-customer-owned-lark-base-app-token",
    "LARK_TABLE_RAW_TIKTOK_CREATOR_VIDEOS": "replace-with-table-id",
    "LARK_TABLE_MKT_CONTENT": "replace-with-table-id",
    "LARK_TABLE_MKT_CONTENT_DAILY": "replace-with-table-id",
    "LARK_TABLE_MKT_CLASSIFICATION_DICTIONARY": "replace-with-table-id",
    "LARK_TABLE_MKT_METRIC_DEFINITIONS": "replace-with-table-id",

    // ค่า Tuning เริ่มต้น ปรับผ่าน Environment ได้โดยไม่แก้ Source code
    "LARK_MIN_REQUEST_INTERVAL_MS": "150",
    "LARK_REQUEST_TIMEOUT_MS": "30000",
    "LARK_MAX_ATTEMPTS": "5",
    "LARK_MAX_PAGES": "1000",
    "LARK_MAX_FILTER_CONDITIONS": "50"
  }
}
