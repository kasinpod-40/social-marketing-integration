{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "social-mkt-api-worker",
  "main": "apps/api-worker/src/index.js",
  "compatibility_date": "2026-07-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "social_mkt",
      "database_id": "replace-with-client-owned-d1-id"
    }
  ],
  "queues": {
    "producers": [
      {
        "queue": "social-mkt-sync-jobs",
        "binding": "SYNC_QUEUE"
      }
    ],
    "consumers": [
      {
        "queue": "social-mkt-lark-writes",
        "max_batch_size": 25,
        "max_batch_timeout": 30
      }
    ]
  },
  "vars": {
    "APP_ENV": "staging",
    "DEFAULT_TIMEZONE": "Asia/Bangkok",
    "LARK_APP_TOKEN": "replace-with-lark-base-app-token",
    "LARK_TABLE_RAW_TIKTOK_CREATOR_VIDEOS": "tblMdO6XCti94EwH",
    "LARK_TABLE_MKT_CONTENT": "tbllvswTYP1dQGf3",
    "LARK_TABLE_MKT_CONTENT_DAILY": "tbl5n2rbZU7NO07w",
    "TIKTOK_CREATOR_ACCOUNT_ID": "replace-with-tiktok-account-id",
    "LARK_TABLE_MKT_ACCOUNTS": "tblDcT7CVveNlNpP",
    "LARK_TABLE_MKT_ADS_ACCOUNTS": "tbl3yPcXdQzZQvBc",
    "LARK_TABLE_MKT_ADS_CAMPAIGNS": "tblR7FwJ2tasEKPy",
    "LARK_TABLE_MKT_ADS_ADGROUPS": "tblsFufuixpig0Tf",
    "LARK_TABLE_MKT_ADS_CREATIVES": "tblmWi81dZ98v4dc",
    "LARK_TABLE_MKT_ADS_DAILY": "tblPTMsC9J32gukX",
    "LARK_TABLE_MKT_METRIC_DEFINITIONS": "tblk2Ho99sXqLLE2",
    "LARK_TABLE_MKT_REPORT_SNAPSHOTS": "tbl81gHrMESpDolN",
    "LARK_TABLE_MKT_AI_REPORT_RUNS": "tblCX8IMtOiahI1x",
    "LARK_TABLE_MKT_REPORT_SETTINGS": "tblYzXA6m9G0PvIs",
    "LARK_TABLE_MKT_SYNC_LOG": "tblpgnHODi8MIcso",
    "LARK_TABLE_MKT_SYSTEM_ALERTS": "tbl5Cq9iVkWTFdA4",
    "LARK_TABLE_RAW_TIKTOK_BUSINESS_CAMPAIGNS": "tblaHQOIAR1Yolk5",
    "LARK_TABLE_RAW_TIKTOK_BUSINESS_ADGROUPS": "tbluOIJPRMgHHmyx",
    "LARK_TABLE_RAW_TIKTOK_BUSINESS_ADS": "tblgxZSqOFMpkykU",
    "LARK_TABLE_RAW_GOOGLE_CAMPAIGNS": "tblsxhuZJCDtk4wg",
    "LARK_TABLE_RAW_GOOGLE_CUSTOMER_LISTS": "tblS5Rki3QS7Wg1H"
  }
}
