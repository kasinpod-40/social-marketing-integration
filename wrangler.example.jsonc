{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "social-mkt-api-worker",
  "main": "apps/api-worker/src/index.js",
  "compatibility_date": "2026-07-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "social_mkt",
      "database_id": "replace-with-client-owned-d1-id"
    }
  ],
  "queues": {
    "producers": [
      {
        "queue": "social-mkt-sync-jobs",
        "binding": "SYNC_QUEUE"
      }
    ],
    "consumers": [
      {
        "queue": "social-mkt-lark-writes",
        "max_batch_size": 25,
        "max_batch_timeout": 30
      }
    ]
  },
  "vars": {
    "APP_ENV": "staging",
    "DEFAULT_TIMEZONE": "Asia/Bangkok",
    "LARK_APP_TOKEN": "replace-with-lark-base-app-token",
    "LARK_TABLE_RAW_TIKTOK_CREATOR_VIDEOS": "replace-with-raw-tiktok-creator-videos-table-id",
    "LARK_TABLE_MKT_CONTENT": "replace-with-mkt-content-table-id",
    "LARK_TABLE_MKT_CONTENT_DAILY": "replace-with-mkt-content-daily-table-id",
    "TIKTOK_CREATOR_ACCOUNT_ID": "replace-with-tiktok-account-id",
    "LARK_TABLE_MKT_ACCOUNTS": "replace-with-mkt-accounts-table-id",
    "LARK_TABLE_MKT_ADS_ACCOUNTS": "replace-with-mkt-ads-accounts-table-id",
    "LARK_TABLE_MKT_ADS_CAMPAIGNS": "replace-with-mkt-ads-campaigns-table-id",
    "LARK_TABLE_MKT_ADS_ADGROUPS": "replace-with-mkt-ads-adgroups-table-id",
    "LARK_TABLE_MKT_ADS_CREATIVES": "replace-with-mkt-ads-creatives-table-id",
    "LARK_TABLE_MKT_ADS_DAILY": "replace-with-mkt-ads-daily-table-id",
    "LARK_TABLE_MKT_METRIC_DEFINITIONS": "replace-with-mkt-metric-definitions-table-id",
    "LARK_TABLE_MKT_REPORT_SNAPSHOTS": "replace-with-mkt-report-snapshots-table-id",
    "LARK_TABLE_MKT_AI_REPORT_RUNS": "replace-with-mkt-ai-report-runs-table-id",
    "LARK_TABLE_MKT_REPORT_SETTINGS": "replace-with-mkt-report-settings-table-id",
    "LARK_TABLE_MKT_SYNC_LOG": "replace-with-mkt-sync-log-table-id",
    "LARK_TABLE_MKT_SYSTEM_ALERTS": "replace-with-mkt-system-alerts-table-id",
    "LARK_TABLE_MKT_CLASSIFICATION_DICTIONARY": "replace-with-mkt-classification-dictionary-table-id",
    "LARK_TABLE_RAW_TIKTOK_BUSINESS_CAMPAIGNS": "replace-with-raw-tiktok-business-campaigns-table-id",
    "LARK_TABLE_RAW_TIKTOK_BUSINESS_ADGROUPS": "replace-with-raw-tiktok-business-adgroups-table-id",
    "LARK_TABLE_RAW_TIKTOK_BUSINESS_ADS": "replace-with-raw-tiktok-business-ads-table-id",
    "LARK_TABLE_RAW_GOOGLE_CAMPAIGNS": "replace-with-raw-google-campaigns-table-id",
    "LARK_TABLE_RAW_GOOGLE_CUSTOMER_LISTS": "replace-with-raw-google-customer-lists-table-id"
  }
}
