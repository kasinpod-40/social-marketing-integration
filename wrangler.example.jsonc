{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "social-mkt-api-worker",
  "main": "apps/api-worker/src/index.js",
  "compatibility_date": "2026-07-15",
  "vars": {
    // Environment หลักของระบบ: development หรือ production
    "MKT_ENV": "development",
    // โปรไฟล์ลูกค้าที่เตรียมไว้ในโค้ด
    "MKT_CUSTOMER_PROFILE": "integration_workspace",
    // Timezone กลางของรายงานและ Daily Snapshot
    "DEFAULT_TIMEZONE": "Asia/Bangkok",

    // Feature flags ของ Connector: ช่องทางที่ยังไม่มี Implementation จริงต้องคง false
    "MKT_CONNECTOR_TIKTOK_ENABLED": "false",
    "MKT_CONNECTOR_FACEBOOK_ENABLED": "false",
    "MKT_CONNECTOR_INSTAGRAM_ENABLED": "false",
    "MKT_CONNECTOR_GOOGLE_ADS_ENABLED": "false",
    // PREVIEW ingress, one-time Secret provisioning และ Business writer เป็นคนละ Gate
    // Release example ต้องปิดทั้งหมด และ Migration 0014 source ยังไม่อนุญาตให้ Apply Remote
    "MKT_GOOGLE_ADS_SIGNED_INGRESS_ENABLED": "false",
    "MKT_GOOGLE_ADS_SECRET_PROVISIONING_ENABLED": "false",
    "MKT_GOOGLE_ADS_BUSINESS_WRITE_ENABLED": "false",
    "MKT_GOOGLE_ADS_MANAGER_CUSTOMER_ID": "replace-with-10-digit-manager-customer-id",
    "MKT_GOOGLE_ADS_ADVERTISER_CUSTOMER_ID": "replace-with-10-digit-advertiser-customer-id",
    "MKT_GOOGLE_ADS_SOURCE_TIMEZONE": "Asia/Bangkok",
    "MKT_GOOGLE_ADS_SIGNING_KEY_ID": "replace-with-non-secret-key-id",
    "MKT_CONNECTOR_YOUTUBE_ENABLED": "false",
    "MKT_CONNECTOR_WOOCOMMERCE_ENABLED": "false",
    "MKT_CONNECTOR_CHATWOOT_ENABLED": "false",

    // Handle จริงต้องอยู่ใน Local/Environment config และเปิด Connector หลัง UAT เท่านั้น
    "TIKTOK_SOURCE_HANDLE": "replace-with-tiktok-handle"
  },
  "d1_databases": [
    {
      // Transport/provisioning state ใช้ D1 binding; Remote Migration ต้องอนุมัติแยกก่อน Deploy
      "binding": "MKT_STATE_DB",
      "database_name": "replace-with-environment-specific-d1-name",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "./migrations"
    }
  ],
  "queues": {
    "producers": [
      {
        // API Worker ส่งงาน Sync ไปยัง Queue แต่ไม่เป็น Consumer เอง
        "queue": "social-mkt-sync-jobs",
        "binding": "SYNC_QUEUE"
      }
    ]
  }
}
